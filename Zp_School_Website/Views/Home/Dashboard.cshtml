@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="gov-dashboard">

    <!-- PAGE HEADING -->
    <section class="dashboard-heading">
        <div>
            <span class="page-eyebrow">SCHOOL ADMINISTRATION</span>
            <h1>Dashboard</h1>
            <p>Overview of school activities and academic information.</p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMMM yyyy")
        </div>
    </section>

    <!-- SUMMARY CARDS -->
    <section class="row g-3 dashboard-stats">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="gov-stat-card">
                <div class="stat-icon stat-blue">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-label">Total Students</div>
                <div class="stat-number">1,248</div>
                <div class="stat-note">Currently enrolled</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="gov-stat-card">
                <div class="stat-icon stat-green">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <div class="stat-label">Teaching Staff</div>
                <div class="stat-number">42</div>
                <div class="stat-note">Teachers and educators</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="gov-stat-card">
                <div class="stat-icon stat-orange">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="stat-label">Attendance Today</div>
                <div class="stat-number">94.6<small>%</small></div>
                <div class="stat-note">Daily attendance rate</div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="gov-stat-card">
                <div class="stat-icon stat-purple">
                    <i class="bi bi-mortarboard"></i>
                </div>
                <div class="stat-label">Classes</div>
                <div class="stat-number">18</div>
                <div class="stat-note">Active class sections</div>
            </div>
        </div>

    </section>

    <!-- MAIN DASHBOARD PANELS -->
    <section class="row g-3 dashboard-main mt-1">

        <!-- ATTENDANCE OVERVIEW -->
        <div class="col-12 col-lg-7">
            <div class="gov-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Attendance Overview</h2>
                        <p>Weekly student attendance summary</p>
                    </div>
                    <span class="panel-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </span>
                </div>

                <div class="attendance-summary">
                    <div>
                        <span class="summary-label">Present today</span>
                        <strong class="text-success">1,180</strong>
                    </div>
                    <div>
                        <span class="summary-label">Absent today</span>
                        <strong class="text-danger">68</strong>
                    </div>
                </div>

                <div class="weekly-chart"
                     aria-label="Illustrative weekly attendance chart">

                    <div class="chart-column">
                        <div class="chart-bar" style="height:82%"></div>
                        <span>Mon</span>
                    </div>

                    <div class="chart-column">
                        <div class="chart-bar" style="height:91%"></div>
                        <span>Tue</span>
                    </div>

                    <div class="chart-column">
                        <div class="chart-bar" style="height:86%"></div>
                        <span>Wed</span>
                    </div>

                    <div class="chart-column">
                        <div class="chart-bar" style="height:95%"></div>
                        <span>Thu</span>
                    </div>

                    <div class="chart-column">
                        <div class="chart-bar" style="height:89%"></div>
                        <span>Fri</span>
                    </div>

                    <div class="chart-column">
                        <div class="chart-bar" style="height:60%"></div>
                        <span>Sat</span>
                    </div>
                </div>

                <div class="chart-caption">
                    <span>
                        <i class="legend-dot"></i>
                        Attendance percentage
                    </span>
                    <span>Sample data</span>
                </div>
            </div>
        </div>

        <!-- QUICK ACCESS -->
        <div class="col-12 col-lg-5">
            <div class="gov-panel quick-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Quick Access</h2>
                        <p>Frequently used school services</p>
                    </div>
                </div>

                <a class="quick-link"
                   href="@Url.Action("Index", "Students")">
                    <span class="quick-link-icon">
                        <i class="bi bi-people"></i>
                    </span>
                    <span class="quick-link-content">
                        <strong>School Information</strong>
                        <small>View and manage student details</small>
                    </span>
                    <i class="bi bi-chevron-right quick-arrow"></i>
                </a>

                <a class="quick-link"
                   href="@Url.Action("Index", "Attendance")">
                    <span class="quick-link-icon">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                    <span class="quick-link-content">
                        <strong>Attendance Register</strong>
                        <small>Review daily attendance</small>
                    </span>
                    <i class="bi bi-chevron-right quick-arrow"></i>
                </a>

                <a class="quick-link"
                   href="@Url.Action("Index", "Fees")">
                    <span class="quick-link-icon">
                        <i class="bi bi-receipt"></i>
                    </span>
                    <span class="quick-link-content">
                        <strong>Fee Management</strong>
                        <small>Review fee records and payments</small>
                    </span>
                    <i class="bi bi-chevron-right quick-arrow"></i>
                </a>

                <a class="quick-link"
                   href="@Url.Action("Index", "Exams")">
                    <span class="quick-link-icon">
                        <i class="bi bi-journal-text"></i>
                    </span>
                    <span class="quick-link-content">
                        <strong>Examinations</strong>
                        <small>Manage exams and results</small>
                    </span>
                    <i class="bi bi-chevron-right quick-arrow"></i>
                </a>
            </div>
        </div>

    </section>

    <!-- RECENT ADMISSIONS -->
    <section class="gov-panel admissions-panel">

        <div class="panel-heading">
            <div>
                <h2>Recent Admissions</h2>
                <p>Recently registered students</p>
            </div>

            <a class="view-all-link"
               href="@Url.Action("Index", "Students")">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="table-responsive">
            <table class="table gov-table align-middle">

                <thead>
                    <tr>
                        <th>Admission No.</th>
                        <th>Student Name</th>
                        <th>Class</th>
                        <th>Admission Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>ADM-2026-001</td>
                        <td class="student-cell">Aarav Sharma</td>
                        <td>Class I - A</td>
                        <td>05 Oct 2026</td>
                        <td>
                            <span class="status-label">Registered</span>
                        </td>
                    </tr>

                    <tr>
                        <td>ADM-2026-002</td>
                        <td class="student-cell">Ananya Patil</td>
                        <td>Class II - B</td>
                        <td>04 Oct 2026</td>
                        <td>
                            <span class="status-label">Registered</span>
                        </td>
                    </tr>

                    <tr>
                        <td>ADM-2026-003</td>
                        <td class="student-cell">Rohan Deshmukh</td>
                        <td>Class III - A</td>
                        <td>03 Oct 2026</td>
                        <td>
                            <span class="status-label">Registered</span>
                        </td>
                    </tr>
                </tbody>

            </table>
        </div>
    </section>

</div>