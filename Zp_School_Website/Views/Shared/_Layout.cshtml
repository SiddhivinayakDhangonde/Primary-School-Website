<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Bright Future Primary School</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/school-admin.css")" />

    @RenderSection("styles", required: false)
</head>
<body>
    <!-- HEADER -->
    <header class="admin-header">
        <a href="@Url.Action("Dashboard", "Home")" class="school-brand">
            <span class="school-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </span>

            <span class="school-brand-text">
                <strong>Bright Future Primary School</strong>
                <small>School Administration Portal</small>
            </span>
        </a>

        <div class="header-right">
            <span class="admin-welcome">
                <i class="bi bi-person-circle"></i>
                <span>
                    <strong>Administrator</strong>
                    <small>School Admin</small>
                </span>
            </span>

            <a href="@Url.Action("Index", "Home")"
               class="header-home"
               title="Visit home page">
                <i class="bi bi-house-door"></i>
                <span>Home</span>
            </a>
        </div>
    </header>

    <!-- SIDEBAR + SCROLLABLE CONTENT -->
    <div class="admin-shell">

        <aside class="admin-sidebar">
            <div class="sidebar-heading">MAIN MENU</div>

            <a class="sidebar-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Home") ? "active" : "")"
               href="@Url.Action("Dashboard", "Home")">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Students")">
                <i class="bi bi-people-fill"></i>
                <span>School Information</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Teachers")">
                <i class="bi bi-person-workspace"></i>
                <span>Teachers</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Activities")">
                <i class="bi bi-easel2-fill"></i>
                <span>Activities</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Attendance")">
                <i class="bi bi-calendar-check-fill"></i>
                <span>Education Body</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Fees")">
                <i class="bi bi-cash-coin"></i>
                <span>School Characters</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Reports")">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span>Reports</span>
            </a>

            <div class="sidebar-heading sidebar-heading-secondary">
                SETTINGS
            </div>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Settings")">
                <i class="bi bi-gear-fill"></i>
                <span>Settings</span>
            </a>

            <a class="sidebar-link"
               href="@Url.Action("Index", "Home")">
                <i class="bi bi-house-fill"></i>
                <span>Website Home</span>
            </a>
        </aside>

        <main class="admin-content">
            <div class="admin-page-content">
                @RenderBody()
            </div>

            <!-- FOOTER -->
            <footer class="admin-footer">
                <span>
                    &copy; @DateTime.Now.Year
                    <strong>Bright Future Primary School</strong>
                </span>

                <span>School Administration System</span>
            </footer>
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
